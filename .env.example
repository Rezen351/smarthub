# ============================================
# ENYX-Smart Hub - Docker Environment
# ============================================

# Environment
NODE_ENV=production

# Server
BACKEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=enyx
POSTGRES_PASSWORD=enyx123
POSTGRES_DB=enyx_smart_hub
POSTGRES_PORT=5432

# Redis (Session Context)
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# MQTT (Mosquitto)
MQTT_PORT=1883
MQTT_WS_PORT=9001

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@enyx.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
