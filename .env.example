# ============================================
# ENYX-Smart Hub - Docker Environment
# ============================================

# Server & Client Ports
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=enyx
POSTGRES_PASSWORD=enyx123
POSTGRES_DB=enyx_smart_hub
POSTGRES_PORT=5432

# Thermal Printers (Reception and Packaging, IW-J300H, 80 mm, Ethernet)
THERMAL_PRINTER_RECEPTION_IP=
THERMAL_PRINTER_RECEPTION_PORT=9100
THERMAL_PRINTER_PACKAGING_IP=
THERMAL_PRINTER_PACKAGING_PORT=9100

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@enyx.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Cloudflare Tunnel (Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

