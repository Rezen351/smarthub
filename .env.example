# ============================================
# ENYX-Smart Hub - Docker Environment
# ============================================

# Environment
NODE_ENV=production

# Server & Client Ports
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=enyx
POSTGRES_PASSWORD=enyx123
POSTGRES_DB=enyx_smart_hub
POSTGRES_PORT=5432

# Redis (Session Context)
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@enyx.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Cloudflare Tunnel (Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Physical Hardware Modbus TCP Scales (LAN IP & Port)
SCALE_STATION_01_HOST=192.168.1.100
SCALE_STATION_01_PORT=502
SCALE_STATION_02_HOST=192.168.1.101
SCALE_STATION_02_PORT=502
SCALE_STATION_03_HOST=192.168.1.102
SCALE_STATION_03_PORT=502

