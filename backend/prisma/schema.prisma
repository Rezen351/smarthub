generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  FARMER
}

enum WaringStatus {
  PENDING
  APPROVED
  SORTED
}

enum PalletStatus {
  ACTIVE
  IN_PACKAGING
  DEPLETED
}

enum PackageFormat {
  RETAIL_POUCH
  EXPORT_CARTON
}

enum PackageStatus {
  STORED
  DISPATCHED
}

enum WashDecision {
  WASHED
  UNWASHED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  farmerProfile  Farmer?
  warings        Waring[]
  sortingBatches SortingBatch[]
  deliveries     Delivery[]

  @@map("users")
}

model Farmer {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. FMR-001
  name      String
  phone     String?
  village   String?
  address   String?
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  warings Waring[]
  pallets Pallet[]

  @@map("farmers")
}

model Commodity {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 001
  name        String   @unique // e.g. Kentang Granola
  description String?
  unit        String   @default("kg")
  createdAt   DateTime @default(now())

  // Relations
  grades  Grade[]
  warings Waring[]

  @@map("commodities")
}

model Grade {
  id          String   @id @default(uuid())
  name        String   // e.g. A, B, C
  sizeSpec    String?  // e.g. >55mm, 40-55mm, <40mm
  description String?
  commodityId String
  createdAt   DateTime @default(now())

  // Relations
  commodity Commodity @relation(fields: [commodityId], references: [id])

  @@unique([name, commodityId])
  @@map("grades")
}

model Waring {
  id            String       @id @default(uuid())
  code          String       @unique // e.g. WRG-20261026-0001
  farmerId      String
  commodityId   String
  operatorId    String?
  grossWeightKg Float
  tareWeightKg  Float        @default(1.2)
  netWeightKg   Float
  status        WaringStatus @default(PENDING)
  note          String?
  createdAt     DateTime     @default(now())
  approvedAt    DateTime?

  // Relations
  farmer       Farmer        @relation(fields: [farmerId], references: [id])
  commodity    Commodity     @relation(fields: [commodityId], references: [id])
  operator     User?         @relation(fields: [operatorId], references: [id])
  sortingBatch SortingBatch?

  @@map("warings")
}

model SortingBatch {
  id           String       @id @default(uuid())
  waringId     String       @unique
  operatorId   String?
  sizerFed     Boolean      @default(true)
  washDecision WashDecision @default(UNWASHED)
  gradeA_Kg    Float        @default(0)
  gradeB_Kg    Float        @default(0)
  gradeC_Kg    Float        @default(0)
  shrinkageKg  Float        @default(0)
  shrinkagePct Float        @default(0)
  sortedAt     DateTime     @default(now())

  // Relations
  waring   Waring   @relation(fields: [waringId], references: [id])
  operator User?    @relation(fields: [operatorId], references: [id])
  pallets  Pallet[]

  @@map("sorting_batches")
}

model Pallet {
  id             String       @id @default(uuid())
  code           String       @unique // e.g. PLT-GRD-A-01
  grade          String       // A, B, C
  farmerId       String
  sortingBatchId String
  weightKg       Float
  remainingKg    Float
  status         PalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  // Relations
  farmer       Farmer        @relation(fields: [farmerId], references: [id])
  sortingBatch SortingBatch  @relation(fields: [sortingBatchId], references: [id])
  packages     PackageUnit[]

  @@map("pallets")
}

model PackageUnit {
  id             String        @id @default(uuid())
  code           String        @unique // e.g. PCH-20261026-0001 or EXP-20261026-0001
  format         PackageFormat @default(RETAIL_POUCH)
  grade          String        // A, B, C
  weightKg       Float
  barcode        String        @unique // GS1 Digital Link QR or ITF-14
  cartonSpec     String?       // 10kg or 50kg
  sourcePalletId String
  deliveryId     String?
  status         PackageStatus @default(STORED)
  createdAt      DateTime      @default(now())

  // Relations
  sourcePallet Pallet    @relation(fields: [sourcePalletId], references: [id])
  delivery     Delivery? @relation(fields: [deliveryId], references: [id])

  @@map("package_units")
}

model Delivery {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. DLV-20261026-0001
  truckPlate  String
  destination String
  driverName  String
  operatorId  String?
  departedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  // Relations
  operator User?         @relation(fields: [operatorId], references: [id])
  packages PackageUnit[]

  @@map("deliveries")
}
