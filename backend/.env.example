# ============================================
# ENYX-Smart Hub - Environment Variables
# ============================================

# Environment
NODE_ENV=development

# Server
PORT=3000
BACKEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=enyx
POSTGRES_PASSWORD=enyx123
POSTGRES_DB=enyx_smart_hub
POSTGRES_PORT=5432
DATABASE_URL="postgresql://enyx:enyx123@localhost:5432/enyx_smart_hub?schema=public"

# Redis (Session Context)
REDIS_PASSWORD=redis123
REDIS_PORT=6379
REDIS_URL="redis://:redis123@localhost:6379"

# MQTT (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Barcode/QR Generation
BWIPJS_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@enyx.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
