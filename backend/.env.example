# ============================================
# SmartGeulis Traceability System - Environment Variables
# ============================================

# Server
PORT=3000
BACKEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=enyx
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=enyx_smart_hub
POSTGRES_PORT=5432
DATABASE_URL="postgresql://enyx:your_secure_postgres_password@localhost:5432/enyx_smart_hub?schema=public"

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Barcode/QR Generation
BWIPJS_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_secure_pgadmin_password
PGADMIN_PORT=5050

# Thermal Printers (Reception and Packaging, IW-J300H, 80 mm, Ethernet)
THERMAL_PRINTER_RECEPTION_IP=
THERMAL_PRINTER_RECEPTION_PORT=9100
THERMAL_PRINTER_PACKAGING_IP=
THERMAL_PRINTER_PACKAGING_PORT=9100
