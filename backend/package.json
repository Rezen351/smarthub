{
  "name": "enyx-smart-hub-backend",
  "version": "1.0.0",
  "description": "ENYX-Smart Hub Backend API - IoT-based potato packaging and warehouse management system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "swagger:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.2.0",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.0.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
